# Porta HTTP/WebSocket do backend Node
PORT=3000
# Conexão com o PostgreSQL (o mesmo banco usado pelo backend Java)
DATABASE_URL=postgresql://corrida:troque-esta-senha@localhost:5433/corrida_dos_dois?schema=public
# Banco separado usado SOMENTE por "npm run test:db" (é limpo a cada execução)
TEST_DATABASE_URL=postgresql://corrida:troque-esta-senha@localhost:5433/corrida_dos_dois_test?schema=public
# Origens do frontend autorizadas (CORS e WebSocket), separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Tempo (segundos) que um jogador desconectado tem para voltar à sala
RECONNECT_GRACE_SECONDS=60
# NUNCA habilite em produção: permite forçar valores do dado em testes automatizados
ENABLE_TEST_ENDPOINTS=false
# debug | info | warn | error
LOG_LEVEL=info
