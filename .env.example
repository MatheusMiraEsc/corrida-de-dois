# Copie para ".env" e TROQUE A SENHA antes de usar. Lido pelo docker compose.

# --- Banco de dados ---------------------------------------------------------
POSTGRES_USER=corrida
# Use só letras e números (a senha vai dentro da URL de conexão).
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=corrida_dos_dois
# Porta no SEU computador (5433 evita conflito com um PostgreSQL já instalado).
POSTGRES_PORT=5433

# --- Backend Node -------------------------------------------------------------
BACKEND_NODE_PORT=3000
# Endereço(s) de onde o frontend é aberto, separados por vírgula.
CORS_ORIGINS=http://localhost:8081
RECONNECT_GRACE_SECONDS=60
LOG_LEVEL=info

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=8081
# Backend que o navegador vai usar. Para jogar de outro computador da rede,
# troque "localhost" pelo IP desta máquina (e inclua a origem em CORS_ORIGINS).
FRONTEND_API_URL=http://localhost:3000
FRONTEND_WS_URL=ws://localhost:3000/ws
